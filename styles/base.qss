/* 基础样式 */

/* Global Window Style */
QWidget#PlayWidget {
    background-color: #f0f0f0;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
}

/* Player Widget Container Style */
QWidget#playerWidget {
    background-color: #f0f0f0;
    border-radius: 0px;
    border: none;
}

/* General Button Styling - Flat Look */
QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 18px;
    padding: 5px;
    color: #555555;
}
QPushButton:hover {
    background-color: #e0e0e0;
}
QPushButton:pressed {
    background-color: #d0d0d0;
}

/* Current Song Label */
QLabel#currentSongLabel {
    font-weight: 500; 
    font-size: 10pt; 
    color: #303030; 
    padding-bottom: 4px; 
    padding-left: 8px;
} 