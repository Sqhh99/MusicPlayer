/* 播放器控件样式 */

/* Time Labels */
QLabel#curLabel, QLabel#totalLibel {
    color: #777777;
    font-size: 9pt;
    padding: 0px 5px;
}

/* Progress Slider - Slimmer */
QSlider#playCourseSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #cccccc;
    border-radius: 2px;
    margin: 0px 0;
}
QSlider#playCourseSlider::handle:horizontal {
    background-color: #333333;
    border: none;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin: -3px 0;
}
QSlider#playCourseSlider::handle:horizontal:hover {
    background-color: #000000;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: -4px 0;
}
QSlider#playCourseSlider::sub-page:horizontal {
    background: #777777;
    border-radius: 2px;
} 